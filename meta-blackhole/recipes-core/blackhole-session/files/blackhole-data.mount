[Unit]
Description=Blackhole persistent data partition
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target blackholed.service blackhole-kiosk.service
After=local-fs-pre.target
# Do not block boot if the label is missing (nofail).
TimeoutSec=15

[Mount]
What=/dev/disk/by-label/bhdata
Where=/var/lib/blackhole
Type=ext4
Options=defaults,nofail

[Install]
WantedBy=local-fs.target
