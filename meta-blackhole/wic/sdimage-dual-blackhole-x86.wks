# Blackhole OS dual rootfs + data for generic x86_64 (sda)
# p1: EFI/boot, p2: rootfs A, p3: rootfs B, p4: persistent data

part /boot --source bootimg-efi --sourceparams="loader=grub-efi" --ondisk sda --fstype=vfat --label efi --active --align 1024 --size 64
part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs_a --align 1024 --size 4096
part / --source rootfs --ondisk sda --fstype=ext4 --label rootfs_b --align 1024 --size 4096
part --ondisk sda --fstype=ext4 --label bhdata --align 1024 --size 1024
bootloader --ptable gpt
