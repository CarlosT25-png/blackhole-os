[Unit]
Description=Blackhole Chromium kiosk
After=weston.service nginx.service blackholed.service
Requires=weston.service
Wants=nginx.service blackholed.service

[Service]
Type=simple
# weston.socket listens on /run/wayland-0 (see weston-init).
Environment=XDG_RUNTIME_DIR=/run
Environment=WAYLAND_DISPLAY=wayland-0
Environment=BLACKHOLE_SHELL_URL=http://127.0.0.1/
Environment=BLACKHOLE_UI_SCALE=1.0
Environment=LD_LIBRARY_PATH=/opt/chromium/lib:/opt/chromium
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/chromium-kiosk
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
