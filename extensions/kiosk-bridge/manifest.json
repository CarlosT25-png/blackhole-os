{
  "manifest_version": 3,
  "name": "Blackhole Kiosk Bridge",
  "version": "0.1.2",
  "description": "Home chip + Escape/Home back to Blackhole shell; watches launch requests.",
  "permissions": ["storage", "alarms", "tabs", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Blackhole Kiosk Bridge"
  }
}
